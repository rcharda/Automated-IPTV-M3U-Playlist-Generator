<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <title>VAVOO.TO</title>
  
  <link rel="stylesheet" href="/vuma/fe59687f7417670f/style.css">
  <link rel="icon" href="https://img.icons8.com/color/452/pizza.png">
  <meta name="theme-color" content="#1A1F26">
  
  <meta name="mhub" content="app dpad">
</head>
<body>
  <div id="app">
    
    <div style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;background:#1A1F26;color:#B8B8B8">
      <img src="https://img.icons8.com/color/452/pizza.png" alt="" width="56" height="56">
      <div style="width:22px;height:22px;border-radius:50%;border:2px solid rgba(255,255,255,.15);border-top-color:#EB2B58;animation:boot-spin .8s linear infinite"></div>
      <style>@keyframes boot-spin { to { transform: rotate(360deg); } }</style>
    </div>
  </div>
  <script type="module">
    import { mount } from "/vuma/fe59687f7417670f/app.js";
    mount({
      addons: [new URL("/", location.href).href],
      addonManager: "open",
      links: [{"id":"vavoo","name":"VAVOO.TO","icon":"https://img.icons8.com/color/452/pizza.png","endpoints":["/","https://www.vavoo.to","https://www.vavoo.top","https://www.voltop.net"]}],
      brand: {
        name: "VAVOO.TO",
        logo: "https://img.icons8.com/color/452/pizza.png",
        icon: "https://img.icons8.com/color/452/pizza.png",
        colors: { accent: "#EB2B58", bg: "#1A1F26", text: "#F4F6F8" },
      },
    });
  </script>
</body>
</html>
